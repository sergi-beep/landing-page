          <div className="hero-3d-float w-full h-full">
            {/* Chrome/Glass Ring */}
            <div className="absolute inset-0 rounded-full border-[3px] border-brand-blue/20 mask-radial">
              <div className="absolute inset-[20px] rounded-full border-[2px] border-brand-blue/30"></div>
              <div className="absolute inset-[40px] rounded-full border-[1px] border-brand-blue/40"></div>
              {/* Glow effect */}
              <div className="absolute inset-0 rounded-full bg-gradient-to-br from-brand-blue/10 via-transparent to-transparent blur-2xl"></div>
            </div>
