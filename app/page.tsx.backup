                  <p className="text-3xl lg:text-4xl font-extrabold tracking-tight text-white mb-1">40+</p>
                  <p className="text-sm text-white/30 font-medium">GTM systems built</p>
                </div>
                <div className="text-center border-x border-white/[0.06]">
                  <p className="text-3xl lg:text-4xl font-extrabold tracking-tight text-white mb-1">7+</p>
                  <p className="text-sm text-white/30 font-medium">months avg. retention</p>
