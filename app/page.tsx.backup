              <div className="absolute -inset-8 bg-brand-blue/5 rounded-[3rem] blur-3xl"></div>

              <div className="relative bg-white/[0.03] border-2 border-white/20 rounded-3xl p-12 hover:bg-white/[0.05] hover:border-white/30 transition-all duration-700">
                {/* Price */}
                <div className="text-center mb-12">
                  <div className="text-6xl font-black text-white mb-2">$15,000<span className="text-2xl text-white/50 font-normal">/mo</span></div>
                  <p className="text-white/50">Full-stack AI data infrastructure team</p>
                </div>

                {/* What's included - clean list */}
                <div className="space-y-4 mb-12">
                  <div className="flex items-start gap-3">
                    <div className="w-1.5 h-1.5 bg-white/60 rounded-full mt-2 flex-shrink-0"></div>
                    <p className="text-white/80">Solution architect + dedicated engineering team</p>
                  </div>
                  <div className="flex items-start gap-3">
                    <div className="w-1.5 h-1.5 bg-white/60 rounded-full mt-2 flex-shrink-0"></div>
                    <p className="text-white/80">Monday-to-Monday sprints, working software every week</p>
                  </div>
                  <div className="flex items-start gap-3">
                    <div className="w-1.5 h-1.5 bg-white/60 rounded-full mt-2 flex-shrink-0"></div>
                    <p className="text-white/80">You own all code and documentation</p>
                  </div>
                  <div className="flex items-start gap-3">
                    <div className="w-1.5 h-1.5 bg-white/60 rounded-full mt-2 flex-shrink-0"></div>
                    <p className="text-white/80">No lock-in contracts, cancel anytime</p>
                  </div>
                  <div className="flex items-start gap-3">
                    <div className="w-1.5 h-1.5 bg-white/60 rounded-full mt-2 flex-shrink-0"></div>
                    <p className="text-white/80">Results from the first sprint</p>
                  </div>
                </div>

                {/* CTA */}
                <div className="text-center">
                  <Link
                    href="https://calendly.com/sergi-feq/30min"
                    target="_blank"
                    rel="noopener noreferrer"
                    className="inline-flex items-center gap-3 px-10 py-5 bg-white text-brand-black rounded-full font-bold text-lg hover:shadow-[0_0_40px_rgba(255,255,255,0.3)] hover:scale-105 transition-all duration-300"
                  >
                    Book Discovery Call
                    <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2.5} d="M9 5l7 7-7 7" />
                    </svg>
                  </Link>
                  <p className="text-sm text-white/40 mt-6">30-minute call · No pitch deck · Just diagnosis</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* ═══════════════════════════════════════════
          SECTION 12: FAQ
      ═══════════════════════════════════════════ */}
      <section
        id="faq"
        data-section-id="faq"
        className={`relative py-20 px-8 lg:px-12 bg-gray-50 reveal-section ${visibleSections.has('faq') ? 'visible' : ''}`}
      >
        <div className="max-w-[1200px] mx-auto">
          {/* Headline */}
          <h2 className="text-4xl lg:text-5xl font-extrabold text-brand-black text-center mb-16 tracking-tight">
            You're Thinking It.<br/>
            <span className="text-brand-blue">We'll Answer It.</span>
          </h2>

          {/* FAQ Items */}
          <div className="space-y-4">
            {faqItems.map((item, idx) => (
              <div
                key={idx}
                data-section-id={`faq-${idx}`}
                className={`bg-white border border-gray-200 rounded-xl overflow-hidden reveal-card ${visibleSections.has(`faq-${idx}`) ? 'visible' : ''}`}
              >
                <button
                  onClick={() => setOpenFaq(openFaq === idx ? null : idx)}
                  className="w-full px-6 py-5 flex items-center justify-between text-left hover:bg-gray-50 transition-colors"
                  aria-expanded={openFaq === idx}
                >
                  <span className="font-semibold text-brand-black pr-4">{item.q}</span>
                  <svg
                    className={`w-5 h-5 text-brand-blue flex-shrink-0 transition-transform duration-300 ${openFaq === idx ? 'rotate-180' : ''}`}
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                {openFaq === idx && (
                  <div className="px-6 pb-5 pt-2 text-gray-700 leading-relaxed animate-fadeIn">
                    {item.a}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ═══════════════════════════════════════════
          SECTION 13: FINAL CTA
      ═══════════════════════════════════════════ */}
      <section
        data-section-id="final-cta"
        className={`relative py-20 px-8 lg:px-12 bg-gradient-to-br from-brand-black via-brand-black to-blue-950 text-white reveal-section ${visibleSections.has('final-cta') ? 'visible' : ''}`}
      >
        <div className="max-w-[1400px] mx-auto text-center">
          {/* Quote banner */}
          <div className="mb-12 p-6 bg-white/[0.03] border border-white/10 rounded-2xl">
            <p className="text-2xl lg:text-3xl font-semibold text-white mb-3">
              "I don't want other agencies to have you as a partner."
            </p>
            <p className="text-white/60">Michael, Vangates</p>
          </div>

          {/* Headline */}
          <h2 className="text-4xl lg:text-5xl font-extrabold text-white mb-6 tracking-tight">
            Your Competitors Are Still<br/>
            Running Blind. <span className="text-gradient">You Don't Have To.</span>
          </h2>

          {/* Body */}
          <p className="text-xl text-white/70 mb-10 max-w-2xl mx-auto leading-relaxed">
            30 minutes. We'll look at your data, show you what's invisible and what's leaking, and map out what week one looks like. No pitch deck. No bullshit.
          </p>

          {/* CTA */}
          <Link
            href="https://calendly.com/sergi-feq/30min"
            target="_blank"
            rel="noopener noreferrer"
            className="inline-flex items-center gap-2 px-10 py-5 bg-brand-blue text-white rounded-full font-bold text-lg hover:shadow-[0_0_50px_rgba(0,102,255,0.5)] hover:scale-105 transition-all duration-300 mb-6"
          >
            Let's build yours
            <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2.5} d="M9 5l7 7-7 7" />
            </svg>
          </Link>

          {/* Subtext */}
          <p className="text-sm text-white/40">
            Only 6 clients at a time · 1 spot open · avg. retention 7+ months
          </p>
        </div>
      </section>

      {/* ═══════════════════════════════════════════
          SECTION 14: FOOTER
      ═══════════════════════════════════════════ */}
      <footer className="bg-brand-black text-white py-16 px-8 border-t border-white/[0.06]">
        <div className="max-w-[1400px] mx-auto">
          <div className="grid md:grid-cols-3 gap-12 mb-12">
            {/* Company */}
            <div>
              <Image
                src="/images/logo-full.svg"
                alt="Stimuli Digital"
                width={140}
                height={36}
                className="h-8 w-auto brightness-0 invert mb-4"
              />
              <p className="text-white/40 text-sm leading-relaxed">
                Your GTM Tech Partner.<br/>
                Centralize &gt; See &gt; Act.
              </p>
            </div>

            {/* Navigation */}
            <div>
              <p className="text-white font-semibold mb-4 text-sm">Navigation</p>
              <div className="space-y-2">
                <Link href="#problem" className="block text-white/40 hover:text-white text-sm transition-colors">
                  The Problem
                </Link>
                <Link href="#solution" className="block text-white/40 hover:text-white text-sm transition-colors">
                  Our Approach
                </Link>
                <Link href="#case-studies" className="block text-white/40 hover:text-white text-sm transition-colors">
                  The Scoreboard
                </Link>
                <Link href="#faq" className="block text-white/40 hover:text-white text-sm transition-colors">
                  FAQs
                </Link>
              </div>
            </div>

            {/* Contact */}
            <div>
              <p className="text-white font-semibold mb-4 text-sm">Get Started</p>
              <Link
                href="https://calendly.com/sergi-feq/30min"
                target="_blank"
                rel="noopener noreferrer"
                className="inline-flex items-center gap-2 px-6 py-3 bg-white/10 hover:bg-white/20 border border-white/20 hover:border-white/40 rounded-full text-sm font-medium transition-all duration-300"
              >
                Book a call
                <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5l7 7-7 7" />
                </svg>
              </Link>
            </div>
          </div>

          {/* Copyright */}
          <div className="pt-8 border-t border-white/[0.06] text-center">
            <p className="text-white/30 text-xs">
              © 2025 Stimuli Digital. All rights reserved.
            </p>
          </div>
        </div>
      </footer>
    </main>
  );
}
