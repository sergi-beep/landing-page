        </div>

        <div className="relative max-w-[1400px] mx-auto px-8 lg:px-12 pt-32 pb-20 w-full z-10">
          <div className="max-w-5xl mx-auto text-center">
            {/* Headline */}
            <h1 className="hero-fade-up hero-fade-up-1 text-5xl sm:text-6xl lg:text-[5.5rem] font-extrabold tracking-[-0.03em] leading-[0.95] mb-8 text-white">
              Your GTM Data Is Telling You Everything.<br/>
